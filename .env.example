# Copy to `.env` and adjust values for your local environment:
#   cp .env.example .env
#
# PostgreSQL is external — Compose does not start a database container.

# HTTP server port
PORT=4000

# Runtime environment: development | production
NODE_ENV=development

# Default UI locale
DEFAULT_LOCALE=pt-BR

# Public base URL used when composing short URLs and QR payloads
PUBLIC_BASE_URL=http://localhost:4000

# External PostgreSQL connection
# From the app container (Docker Desktop), use host.docker.internal to reach DB on the host.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=url_shortener
DB_USER=postgres
DB_PASSWORD=postgres

# Auth / session secret (do not use this value in production)
SESSION_SECRET=change-me

# Allow public self-registration at /admin/sign-up (true | false)
# When true, login page shows a link to /admin/sign-up
ALLOW_EXTERNAL_USER_REGISTRATION=true

# Optional UI branding (empty = defaults)
APP_DISPLAY_NAME=Vortius
APP_THEME_COLOR=#0F1F3E
