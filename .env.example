# Copy to `.env` and adjust values for your local environment:
#   cp .env.example .env

# HTTP server port
PORT=4000

# Default UI locale (optional; app default is pt-BR when unset)
# DEFAULT_LOCALE=pt-BR

# Public base URL used when composing short URLs and QR payloads
# PUBLIC_BASE_URL=http://localhost:4000

# PostgreSQL (wired when DB connection is implemented)
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=url_shortener
# DB_USER=postgres
# DB_PASSWORD=postgres

# Auth / session secret (do not use this value in production)
# SESSION_SECRET=change-me
